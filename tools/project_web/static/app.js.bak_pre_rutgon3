    b.disabled = true;
    api('/api/archive', {order}).then(r => { toast('Đã lưu phương án ' + r.saved.label + ' (' + r.saved.files + ' file)'); closeDrawer(); load(true); },
      e2 => { b.disabled = false; toast(e2.message); });
    return;
